# AgroManch AI Knowledge Engine — configuration
# Copy to .env and adjust. All variables are optional; defaults shown.
# Google authentication is handled by `notebooklm login`, NOT by this file —
# no secrets belong here.

# Title of the NotebookLM notebook holding the agricultural knowledge base.
AGROMANCH_NOTEBOOK_NAME="AgroManch Knowledge Base"

# Pin a specific notebook by ID to skip the lookup-by-name (printed by
# scripts/index_knowledge.py). Leave unset to resolve by name.
# AGROMANCH_NOTEBOOK_ID=

# Farmer-facing answer language: "en" (English) or "hi" (Hindi).
AGROMANCH_LANGUAGE=en

# Where generated content and downloaded artifacts are written.
AGROMANCH_OUTPUT_DIR=output

# notebooklm-py auth profile name (for multiple Google accounts). Optional.
# AGROMANCH_PROFILE=

# Timeouts (seconds).
AGROMANCH_SOURCE_WAIT_TIMEOUT=120
AGROMANCH_ARTIFACT_TIMEOUT=600

# Logging: level and format ("json" for structured logs).
AGROMANCH_LOG_LEVEL=INFO
# AGROMANCH_LOG_FORMAT=json
