# AgroManch AI Content Factory — configuration
# Copy to .env and adjust. Defaults shown.
#
# Two credentials are needed:
#   1. NotebookLM (retrieval)  -> handled by `notebooklm login` (no key here)
#   2. Gemini (generation)     -> GEMINI_API_KEY below (the one secret)

# --- Gemini: the central content-generation engine ---
# Get a key from Google AI Studio. GOOGLE_API_KEY is accepted as a fallback.
GEMINI_API_KEY=
# Model: gemini-2.5-flash (fast, high quality) or gemini-2.5-pro (max quality).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7

# Require NotebookLM verified context before generating (true/false). When true,
# generation without trusted-source context is refused unless explicitly
# overridden (e.g. --no-grounding); false-grounded output is marked UNVERIFIED.
AGROMANCH_REQUIRE_GROUNDING=true

# Title of the NotebookLM notebook holding the agricultural knowledge base.
AGROMANCH_NOTEBOOK_NAME="AgroManch Knowledge Base"

# Pin a specific notebook by ID to skip the lookup-by-name (printed by
# scripts/index_knowledge.py). Leave unset to resolve by name.
# AGROMANCH_NOTEBOOK_ID=

# Farmer-facing output language: "hi" (Hindi, default), "en", or "bho" (Bhojpuri).
# Bhojpuri applies to spoken/social assets; SEO + blog stay Hindi/Hinglish.
AGROMANCH_LANGUAGE=hi

# Target audience region for localisation (crops, mandis, examples).
AGROMANCH_REGION=Purvanchal (eastern UP) and Bihar

# Where generated content and downloaded artifacts are written.
AGROMANCH_OUTPUT_DIR=output

# notebooklm-py auth profile name (for multiple Google accounts). Optional.
# AGROMANCH_PROFILE=

# Timeouts (seconds).
AGROMANCH_SOURCE_WAIT_TIMEOUT=120
AGROMANCH_ARTIFACT_TIMEOUT=600

# Logging: level and format ("json" for structured logs).
AGROMANCH_LOG_LEVEL=INFO
# AGROMANCH_LOG_FORMAT=json
